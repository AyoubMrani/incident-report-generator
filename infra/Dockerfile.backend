#  Stage 1: build the frontend 
FROM node:20-slim AS frontend
WORKDIR /frontend

# Install deps first for layer caching.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Build the SPA.
COPY frontend/ ./
RUN npm run build            # -> /frontend/dist

#  Stage 2: backend 
FROM python:3.11-slim
WORKDIR /app

# Python deps first for layer caching.
#
# CPU-only torch, from PyTorch's CPU index.
#
# sentence-transformers pulls torch, and pip's default wheel is the CUDA build:
# ~430 MB of torch plus ~445 MB of nvidia_cudnn and the rest of the CUDA
# runtime. None of it can be used here — the container has no GPU and the
# embedding model runs on CPU — and downloading it made `docker compose up
# --build` fail on a clean machine. The CPU index cuts roughly a gigabyte from
# the image and removes the failure with it.
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements.txt

# App code, including alembic/ and alembic.ini — the entrypoint runs
# `alembic upgrade head` before starting, so the migration chain must ship.
COPY backend/ ./backend/

COPY --from=frontend /frontend/dist ./frontend/dist

WORKDIR /app/backend
ENV PYTHONUNBUFFERED=1
# reports/ is bind-mounted from the repo in compose; REPORTS_DIR points at it.
ENV REPORTS_DIR=/data/reports
# Cache the sentence-transformers model on a mounted volume across restarts.
ENV HF_HOME=/data/hf-cache
# Embedding cache: a writable path inside the image, so a restart skips
# re-encoding even when no volume is mounted for it.
ENV EMBED_CACHE_DIR=/data/embed-cache

# Run as a non-root user. A container that writes customer incident data should
# not be root: a process escape or a path-traversal bug in file handling is
# meaningfully less dangerous as an unprivileged uid. The mounted paths are
# chowned so the app can still write the chat DB, caches and reports.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /data/reports /data/hf-cache /data/chat /data/embed-cache \
    && chown -R appuser:appuser /data /app
COPY infra/entrypoint.sh /usr/local/bin/entrypoint.sh
# Belt and braces alongside .gitattributes: a clone made before that file
# existed (or with an overriding core.autocrlf) still has CRLF on disk, and a
# CRLF shebang makes this image fail to start with a misleading ENOENT.
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh
# Note: no `USER appuser` here. Named volumes are created root-owned when they
# are mounted, which masks the chown above — so the entrypoint starts as root
# only long enough to hand those paths over, then execs the app as appuser.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

EXPOSE 8000

# Compose and any orchestrator can then restart on unhealthy rather than only
# on process exit — the app can be up but unable to serve (KB failed to index).
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/api/health', timeout=4).status==200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
