# Environment for the local stack.
#
#   cp infra/.env.example infra/.env
#   docker compose -f infra/docker-compose.yml up --build
#
# Compose reads infra/.env automatically. Every value below has a default in
# docker-compose.yml, so an empty .env still boots — this file exists to show
# what is configurable and, more importantly, what must change before this runs
# anywhere but a laptop.
#
# infra/.env is gitignored. Do not commit real credentials.

# ── Environment ───────────────────────────────────────────────────────────────
# development | staging | production
#
# Not cosmetic. `production` and `staging` refuse to start with AUTH_DISABLED=1,
# and suppress the dev CORS allowance for the Vite server.
APP_ENV=development

# ── Postgres ──────────────────────────────────────────────────────────────────
# CHANGE THESE before any shared or exposed deployment. They are weak on
# purpose so a first `up` works with no setup.
POSTGRES_USER=ntt
POSTGRES_PASSWORD=ntt
POSTGRES_DB=ntt
# Host port. Defaults to 5433, not 5432, because a developer machine usually
# already has a Postgres on the standard port.
POSTGRES_PORT=5433

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
# CHANGE THESE too. minioadmin/minioadmin is MinIO's well-known default and is
# the first thing any scanner tries.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REPORTS_BUCKET=ntt-reports

# Where report blobs live: minio | filesystem
# filesystem keeps the pre-migration behaviour (reports/ on disk) and is the
# rollback path if object storage has to be taken out of the picture.
STORAGE_BACKEND=minio

# ── Keycloak (identity) ───────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# The realm import (infra/keycloak/realm-export.json) seeds three users for
# local use: admin/admin, analyst/analyst, viewer/viewer. Delete or change them
# before this is reachable by anyone else.

# ── Auth ──────────────────────────────────────────────────────────────────────
# AUTH_DISABLED=1 restores the pre-auth X-Client-Id identity: no token needed,
# no Keycloak required. Useful for running the backend alone.
#
# The app refuses to start if this is 1 while APP_ENV is production or staging.
# That guard is the point: a misconfiguration that fails at boot is
# recoverable, one that quietly serves an unauthenticated API is not.
AUTH_DISABLED=0

# Two issuer URLs because the backend and the browser reach Keycloak by
# different names. Tokens are validated against both — the `iss` claim carries
# whichever the browser used, so accepting only the internal one rejects every
# real login.
OIDC_ISSUER=http://keycloak:8080/realms/ntt
OIDC_PUBLIC_ISSUER=http://localhost:8080/realms/ntt
OIDC_CLIENT_ID=ntt-platform

# Verify the `aud` claim. Off by default: Keycloak only sets `aud` when an
# audience mapper is configured, and the realm export includes one, so this can
# be turned on here. Left off so a hand-edited realm does not break logins.
OIDC_VERIFY_AUDIENCE=0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins. Empty is correct when FastAPI serves the SPA itself
# (same origin). Only needed when the frontend is hosted separately.
# CORS_ORIGINS=https://incidents.example.com

# ── LLM (unchanged: self-hosted Ollama, no cloud) ─────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT=300

# ── Logging ───────────────────────────────────────────────────────────────────
# text | json — json when shipping to a log collector.
LOG_FORMAT=text
LOG_LEVEL=INFO
